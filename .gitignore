# Build outputs and generated artifacts
out/
build/
.vs/
x64/
Win32/
Debug/
Release/
*.user
*.aps
*.log

# Python
__pycache__/
*.pyc
.mypy_cache/

# Generated inside data\ by frequency_builder
data/PhraseFreq.txt
build32/

# macOS shell (mac/). mac/build/ is already covered by the unanchored build/
# above; mac/dist/ is not, and is anchored so a future web/dist or data/dist
# is not swallowed silently.
/mac/dist/
*.dSYM/
*.o
.DS_Store

# mac/release/ holds the files copied verbatim into the release ZIP. The
# Release/ rule above is for MSVC output, but git's ignore matching is
# case-insensitive on Windows and swallows this directory without it.
!/mac/release/
!/mac/release/**
